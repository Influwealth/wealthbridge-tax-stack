# Application
DEBUG=False
PORT=8000
SECRET_KEY=change-me-to-a-64-char-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/wealthbridge
POSTGRES_PASSWORD=change-me-strong-password

# OpenWispr relay HMAC secret
OPENWISPR_SECRET=change-me-to-a-32-char-random-string

# Manager.io
MANAGERIO_BASE_URL=https://app.manager.io
MANAGERIO_API_KEY=your-api-key-here

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Bank data ingestion
BANK_DATA_DIR=/data/bank

# Supabase (optional — enables hybrid auth + Supabase Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_BUCKET=tax-documents

# Caffeine Agent (Claude AI reasoning layer)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Redis (leave blank to use in-process fallback)
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Document vault (local path; swap for S3/Supabase in production)
DOCUMENT_VAULT_DIR=/data/wealthbridge_vault

# Admin bootstrap (first_run.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
