# WealthBridge Tax Stack — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.

# Application
DEBUG=False
PORT=8000
SECRET_KEY=change-me-to-a-64-char-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wealthbridge_tax
POSTGRES_PASSWORD=change-me-strong-password

# Stripe
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Plaid
PLAID_CLIENT_ID=REPLACE_ME
PLAID_SECRET=REPLACE_ME
PLAID_ENV=sandbox

# IRS e-file
IRS_EFIN=REPLACE_ME
IRS_ETIN=REPLACE_ME

# JWT
JWT_SECRET_KEY=REPLACE_ME_WITH_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Supabase
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_KEY=REPLACE_ME
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_BUCKET=tax-documents

# Anthropic (Caffeine Agent)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Redis (leave blank to use in-process fallback)
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Document vault
DOCUMENT_VAULT_DIR=/data/wealthbridge_vault
BANK_DATA_DIR=/data/bank

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# OpenWispr relay HMAC secret
OPENWISPR_SECRET=change-me-to-a-32-char-random-string

# Manager.io
MANAGERIO_BASE_URL=https://app.manager.io
MANAGERIO_API_KEY=your-api-key-here

# DeepFlex Supervisor (SAP)
DEEPFLEX_BASE_URL=http://localhost:8000
ARGUS_BASE_URL=http://localhost:7700
SAP_NODE_ID=wealthbridge-tax-stack
